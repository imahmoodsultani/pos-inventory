# Copy to .env.local and fill in. Never commit .env.local.

# Pooled Neon endpoint (host contains "-pooler"). Used by the running app via lib/db/index.ts.
# PgBouncer transaction mode — no session state, no SQL-level PREPARE, no LISTEN.
DATABASE_URL=

# Direct (unpooled) Neon endpoint. Used ONLY by drizzle-kit for migrations.
# Running migrations through the pooled URL will fail or corrupt advisory-lock behaviour.
DATABASE_URL_UNPOOLED=

# Better Auth signing secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Absolute origin Better Auth issues callbacks against, e.g. http://localhost:3000
BETTER_AUTH_URL=

# Stable across deploys, or a till left open all day gets "Failed to find Server Action"
# every time you ship. Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Shared secret for the two Vercel Cron routes; sent as "Authorization: Bearer <value>".
# Generate with: openssl rand -hex 32
CRON_SECRET=
